---
const now = new Date();
let h = now.getHours();
const m = String(now.getMinutes()).padStart(2, '0');
const ampm = h >= 12 ? 'pm' : 'am';
h = h % 12 || 12;
const initialTime = `${h}:${m}`;
---

<div class="text-[15px] font-medium tabular-nums opacity-90 drop-shadow-[0_1px_6px_rgba(0,0,0,.5)]">
  <span id="clock-h">{h}</span><span class="animate-blink inline-block" style="animation:blink 1s steps(1) infinite">:</span><span id="clock-m">{m}</span> <span id="clock-ap">{ampm}</span>
</div>

<script>
  function updateClock() {
    const now = new Date();
    let h = now.getHours();
    const m = String(now.getMinutes()).padStart(2, '0');
    const ap = h >= 12 ? 'pm' : 'am';
    h = h % 12 || 12;
    const hEl = document.getElementById('clock-h');
    const mEl = document.getElementById('clock-m');
    const apEl = document.getElementById('clock-ap');
    if (hEl) hEl.textContent = String(h);
    if (mEl) mEl.textContent = m;
    if (apEl) apEl.textContent = ap;
  }
  updateClock();
  setInterval(updateClock, 500);
</script>
